{
  "info": {
    "name": "RavenTrack API [Automated]",
    "description": "Self-authenticating RavenTrack collection. Before every request the collection pre-request script checks the stored access token; if it is missing or expires within 5 minutes it calls /api/oauth/refresh-token, then saves the new access token, the rotated refresh token and the expiry time to the active environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Skip the refresh request itself so it cannot recurse.",
          "if (pm.info.requestName === 'Refresh Access Token') { return; }",
          "",
          "const url = pm.environment.get('url');",
          "const refreshToken = pm.environment.get('refresh_token');",
          "const accessToken = pm.environment.get('access_token');",
          "const expiresAt = Number(pm.environment.get('access_token_expires_at') || 0);",
          "const skewMs = 5 * 60 * 1000;",
          "",
          "if (accessToken && Date.now() < expiresAt - skewMs) { return; }",
          "",
          "if (!url || !refreshToken) {",
          "  throw new Error('Set \"url\" and \"refresh_token\" in the RavenTrack - JSB Sports environment.');",
          "}",
          "",
          "pm.sendRequest({",
          "  url: url + '/api/oauth/refresh-token',",
          "  method: 'POST',",
          "  header: [",
          "    { key: 'Content-Type', value: 'application/json' },",
          "    { key: 'Accept', value: 'application/json' }",
          "  ],",
          "  body: { mode: 'raw', raw: JSON.stringify({ refresh_token: refreshToken }) }",
          "}, (err, res) => {",
          "  if (err) { throw err; }",
          "  if (res.code !== 200) {",
          "    throw new Error('Token refresh failed: HTTP ' + res.code + ' ' + res.text());",
          "  }",
          "  const body = res.json();",
          "  pm.environment.set('access_token', body.access_token);",
          "  if (body.refresh_token) { pm.environment.set('refresh_token', body.refresh_token); }",
          "  pm.environment.set('access_token_expires_at', String(Date.now() + Number(body.expires_in || 3600) * 1000));",
          "  console.log('RavenTrack: access token refreshed');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response has access_token', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
                  "pm.environment.set('access_token', body.access_token);",
                  "if (body.refresh_token) { pm.environment.set('refresh_token', body.refresh_token); }",
                  "pm.environment.set('access_token_expires_at', String(Date.now() + Number(body.expires_in || 3600) * 1000));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{url}}/api/oauth/refresh-token"
          }
        }
      ]
    },
    {
      "name": "Ping",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authenticated ping returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{url}}/api/ping"
      }
    }
  ]
}
