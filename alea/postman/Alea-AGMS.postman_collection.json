{
  "info": {
    "name": "Alea AGMS",
    "description": "Alea AGMS Stats API. Auth (verified 13 Oct 2026): POST {{alea_base_url}}/token with form fields grant_type=password, userName, password returns an access_token; send it as Authorization: Bearer on /api/Stats. The collection pre-request script does this automatically using alea_username / alea_password. Without a valid token Stats answers HTTP 200 with ResponseCode 2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Group filter is optional: empty alea_group_id sends groups: null (all groups).",
          "const gid = pm.environment.get('alea_group_id');",
          "pm.variables.set('alea_groups_json', gid ? JSON.stringify([gid]) : 'null');",
          "",
          "// Default to today unless days_back is set in the environment.",
          "const daysBack = Number(pm.environment.get('days_back') || 0);",
          "const fmt = d => d.toISOString().slice(0, 10);",
          "const today = new Date(); today.setUTCHours(0, 0, 0, 0);",
          "const start = new Date(today); start.setUTCDate(start.getUTCDate() - daysBack);",
          "const end = new Date(today); end.setUTCDate(end.getUTCDate() + 1);",
          "pm.variables.set('start_date', fmt(start));",
          "pm.variables.set('end_date', fmt(end));",
          "",
          "// Get a Bearer token from /token (password grant) unless we already have a fresh one.",
          "const tok = pm.environment.get('alea_access_token');",
          "const exp = Number(pm.environment.get('alea_token_expires_at') || 0);",
          "if (!tok || Date.now() > exp - 60000) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('alea_base_url') + '/token', method: 'POST',",
          "    header: [{ key: 'Content-Type', value: 'application/x-www-form-urlencoded' }, { key: 'Accept', value: 'application/json' }],",
          "    body: { mode: 'urlencoded', urlencoded: [",
          "      { key: 'grant_type', value: 'password' },",
          "      { key: 'userName', value: pm.environment.get('alea_username') },",
          "      { key: 'password', value: pm.environment.get('alea_password') } ] }",
          "  }, (err, res) => {",
          "    if (err) throw err;",
          "    if (res.code !== 200) throw new Error('Alea /token failed: HTTP ' + res.code + ' ' + res.text().slice(0, 200));",
          "    const b = res.json();",
          "    pm.environment.set('alea_access_token', b.access_token);",
          "    pm.environment.set('alea_token_expires_at', String(Date.now() + Number(b.expires_in || 3600) * 1000));",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Stats - today",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Authenticated (ResponseCode is not 2)', () => pm.expect(body.ResponseCode).to.not.eql(2));",
              "",
              "// Find the row array and show the 10 latest rows as a table (Visualize tab).",
              "const findRows = n => Array.isArray(n) ? n : (n && typeof n === 'object' ? Object.values(n).map(findRows).find(Boolean) : null);",
              "const rows = findRows(body) || [];",
              "pm.test('Rows returned', () => pm.expect(rows.length).to.be.above(0));",
              "const dateKey = rows.length ? Object.keys(rows[0]).find(k => /date|time/i.test(k)) : null;",
              "const latest = (dateKey ? [...rows].sort((a, b) => new Date(b[dateKey]) - new Date(a[dateKey])) : rows.slice(-10)).slice(0, 10);",
              "const cols = latest.length ? Object.keys(latest[0]) : [];",
              "pm.visualizer.set(`<table border=1 cellpadding=4 style=\"border-collapse:collapse;font:12px sans-serif\"><tr>{{#each cols}}<th>{{this}}</th>{{/each}}</tr>{{#each rows}}<tr>{{#each this}}<td>{{this}}</td>{{/each}}</tr>{{/each}}</table>`,",
              "  { cols, rows: latest.map(r => cols.map(c => typeof r[c] === 'object' ? JSON.stringify(r[c]) : r[c])) });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Date\": { \"StartDate\": \"{{start_date}}\", \"EndDate\": \"{{end_date}}\" },\n  \"groupBy\": [4],\n  \"groups\": {{alea_groups_json}},\n  \"locations\": null,\n  \"statisticBy\": null,\n  \"games\": null,\n  \"CCY\": null,\n  \"paymentSources\": null\n}"
        },
        "url": "{{alea_base_url}}/api/Stats",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{alea_access_token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
